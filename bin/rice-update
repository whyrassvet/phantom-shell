#!/usr/bin/env python3
"""rice-update: updates for Phantom Shell.

  rice-update               install the newest version (runs ./install.sh --update in the repo)
  rice-update check [--json] [--offline]
                            compare your version with the newest one on GitHub
  rice-update watch         background: checks after login and every 15 minutes, shows a notification
  rice-update notify        show the "Update is Available!" notification now (to try it)
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from phantom_version import clean, key

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
INSTALLED = DIR + "/version"
CACHE = HOME + "/.cache/rice"
STATE = CACHE + "/update.json"
NOTIFIED = CACHE + "/update-notified"
RAW = "https://raw.githubusercontent.com/whyrassvet/phantom-shell/main/VERSION"
FIRST_WAIT = 45            # seconds after login
EVERY = 15 * 60            # GitHub is asked every 15 minutes
TICK = 30                  # a check from the About tab of the dashboard is noticed within this many seconds
APP = "Phantom Shell"
ICON = HOME + "/.local/share/rice/icon.png"
PREFERENCES = DIR + "/update-settings.json"
DEFAULTS = {"notifications": False, "major_only": False, "beta": True}


def preferences():
    try:
        with open(PREFERENCES) as f:
            saved = json.load(f)
        return {k: saved.get(k) if isinstance(saved.get(k), bool) else v for k, v in DEFAULTS.items()}
    except (OSError, ValueError, AttributeError):
        return DEFAULTS.copy()


def set_preference(name, value):
    if name not in DEFAULTS or value not in ("on", "off"):
        raise ValueError("Invalid update setting")
    prefs = preferences()
    prefs[name] = value == "on"
    os.makedirs(DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".update-settings-", dir=DIR)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(prefs, f)
        os.replace(tmp, PREFERENCES)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    if name == "notifications" and prefs[name]:
        start_watch()
    return prefs


def start_watch():
    if preferences()["notifications"]:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch"],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def release_tag(name, beta):
    version = clean(name)
    if not version or not re.fullmatch(r"[vV]?\d+\.\d+\.\d+(?:-beta(?:\.[0-9A-Za-z-]+)*)?", name):
        return ""
    if not beta and "-" in version:
        return ""
    return version


def releases(r, beta, offline=False):
    if offline:
        result = git(r, "show-ref", "--tags", "--dereference", timeout=10)
    else:
        result = git(r, "ls-remote", "--tags", "origin", timeout=25)
    if result.returncode and not (offline and result.returncode == 1):
        raise RuntimeError(result.stderr.strip() or "Could not list release tags")
    refs = {}
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].startswith("refs/tags/"):
            refs[parts[1][10:]] = parts[0]
    candidates = [(key(v), name, v, refs.get(name + "^{}", sha))
                  for name, sha in refs.items() if (v := release_tag(name, beta))]
    return max(candidates) if candidates else None


def repo():
    try:
        r = open(DIR + "/repo").read().strip()
        if r and os.path.exists(r + "/install.sh"):
            return r
    except OSError:
        pass
    r = HOME + "/phantom-shell"
    return r if os.path.exists(r + "/install.sh") else None


def installed():
    try:
        with open(INSTALLED) as f:
            return clean(f.read()) or "0.0.0"
    except OSError:
        return "0.0.0"   # installed version is unknown


def git(r, *a, timeout=25):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="true", SSH_ASKPASS="true")
    return subprocess.run(["git", "-C", r] + list(a), capture_output=True, text=True, timeout=timeout, env=env)


def news(text, version):
    """first lines of the CHANGELOG entry for this version"""
    out, on = [], False
    for ln in (text or "").splitlines():
        h = ln.strip()
        if h.startswith("## "):
            if on:
                break
            on = h[3:].strip().lstrip("vV").startswith(version)
            continue
        if on and h.startswith(("- ", "* ")):
            out.append(h[2:].strip())
    return out


def latest(offline=False):
    """Select a versioned tag without changing the user's worktree or branch."""
    latest.ahead, latest.sha, latest.log, latest.tag = 0, "", "", ""
    r = repo()
    if not r or not os.path.isdir(r + "/.git") or not shutil.which("git"):
        return "", "A Git repository with an origin remote is required."
    try:
        selected = releases(r, preferences()["beta"], offline)
        if not selected:
            return "", "No releases found for the selected channel."
        _, tag, version, ref = selected
        if not offline:
            fetched = git(r, "fetch", "--quiet", "--no-tags", "--no-write-fetch-head", "origin", "refs/tags/" + tag, timeout=45)
            if fetched.returncode:
                return "", fetched.stderr.strip() or "Could not fetch release."
        checked = git(r, "show", ref + ":VERSION", timeout=5)
        if checked.returncode or clean(checked.stdout) != version:
            return "", "Release tag and VERSION do not match."
        h = git(r, "rev-parse", "--short", ref + "^{commit}", timeout=5)
        cl = git(r, "show", ref + ":CHANGELOG.md", timeout=5)
        latest.sha = h.stdout.strip() if h.returncode == 0 else ""
        latest.object = ref
        latest.log = cl.stdout if cl.returncode == 0 else ""
        latest.tag = tag
        return version, ""
    except (OSError, subprocess.SubprocessError, RuntimeError) as e:
        return "", str(e)


def check(offline=False):
    have = installed()
    new, err = latest(offline)
    newer = bool(new) and key(new) > key(have)
    ahead = getattr(latest, "ahead", 0)
    out = {"installed": have, "latest": new or have, "update": newer or ahead > 0,
           "changes": ahead, "commit": getattr(latest, "sha", ""), "tag": getattr(latest, "tag", ""),
           "news": news(getattr(latest, "log", ""), new or have)[:4],
           "checked": int(time.time()), "error": err if not new else "", "channel": "beta" if preferences()["beta"] else "stable"}
    os.makedirs(CACHE, exist_ok=True)
    try:
        with open(STATE, "w") as f:
            json.dump(out, f)
    except OSError:
        pass
    return out


def terminal_update():
    t = os.environ.get("TERMINAL") or "kitty"
    if not shutil.which(t):
        t = next((x for x in ("kitty", "foot", "alacritty", "wezterm", "konsole", "gnome-terminal") if shutil.which(x)), t)
    subprocess.Popen([t, "-e", HOME + "/.local/bin/rice-update"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def body(st):
    v = st["latest"]
    head = "<b>Update V%s</b>" % v
    if st.get("installed") and st["installed"] != v:
        head += "  ·  you have V%s" % st["installed"]
    elif st.get("changes"):
        head += "  ·  %d new change%s" % (st["changes"], "" if st["changes"] == 1 else "s")
    lines = [head]
    for n in (st.get("news") or [])[:3]:
        lines.append("•  " + n.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    return "\n".join(lines)


def notify(st):
    """the popup; clicking it (or Update now) opens the update in a terminal"""
    if not shutil.which("notify-send"):
        return
    icon = ICON if os.path.exists(ICON) else "system-software-update"
    try:
        r = subprocess.run(["notify-send", "-a", APP, "-i", icon, "-u", "normal", "-t", "20000",
                            "-c", "system.update",
                            "-A", "default=Update now", "-A", "update=Update now", "-A", "later=Later",
                            "--wait", "Update is Available!", body(st)],
                           capture_output=True, text=True, timeout=6 * 3600)
        if r.stdout.strip() in ("default", "update"):
            terminal_update()
    except Exception:
        pass


def notify_bg(st):
    if os.fork() == 0:
        os.setsid()
        notify(st)
        os._exit(0)


def maybe_notify(st):
    """Notify only about selected versions, once per version."""
    prefs = preferences()
    version = clean(st.get("latest", "")) if st else ""
    if not prefs["notifications"] or not st or not st.get("update") or not version:
        return
    if not prefs["beta"] and "-" in version:
        return
    parsed = key(version)
    if prefs["major_only"]:
        have = key(st.get("installed", ""))
        if not have or parsed[:2] <= have[:2]:
            return
    try:
        with open(NOTIFIED) as f:
            told = f.read().strip()
    except OSError:
        told = ""
    tag = "%s.%s" % parsed[:2] if prefs["major_only"] else version
    if told != tag:
        with open(NOTIFIED, "w") as f:
            f.write(tag)
        notify_bg(st)


def mtime(p):
    try:
        return os.path.getmtime(p)
    except OSError:
        return 0


def watch():
    os.makedirs(CACHE, exist_ok=True)
    lk = open(CACHE + "/update-watch.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    time.sleep(FIRST_WAIT)
    last, seen = 0.0, 0.0
    while preferences()["notifications"]:
        try:
            if time.time() - last >= EVERY:
                last = time.time()
                st = check()
                seen = mtime(STATE)
                maybe_notify(st)
            else:
                # the About tab of the dashboard (or rice-update check) found something: tell right away
                m = mtime(STATE)
                if m and m != seen:
                    seen = m
                    maybe_notify(json.load(open(STATE)))
        except Exception:
            pass
        time.sleep(TICK)


def run(args):
    r = repo()
    if not r:
        print("Could not find your copy of the repo. Clone it again:")
        print("  git clone https://github.com/whyrassvet/phantom-shell ~/phantom-shell")
        input("Press Enter to close")
        sys.exit(1)
    version, error = latest()
    if error or not version:
        print("Could not select a release: " + (error or "no release found"))
        return
    if key(version) <= key(installed()):
        print("No newer release is available for the selected channel.")
        return
    print("Installing release %s (%s channel)." % (version, "beta" if preferences()["beta"] else "stable"), flush=True)
    with tempfile.TemporaryDirectory(prefix="phantom-release-") as tmp:
        archive = subprocess.run(["git", "-C", r, "archive", latest.object], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if archive.returncode:
            print("Could not prepare the release: " + archive.stderr.decode(errors="replace"))
            return
        import io
        with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
            tar.extractall(tmp, filter="data")
        env = dict(os.environ, PHANTOM_UPDATE_REPO=r)
        try:
            code = subprocess.call([tmp + "/install.sh", "--update", "--pulled"] + args, cwd=tmp, env=env)
        finally:
            # Older release installers do not know PHANTOM_UPDATE_REPO and may
            # remember the temporary extraction instead of the real repository.
            marker = os.path.join(DIR, "repo")
            try:
                with open(marker) as f:
                    remembered = f.read().strip()
                if remembered == tmp:
                    with open(marker, "w") as f:
                        f.write(r + "\n")
            except FileNotFoundError:
                pass
    print()
    try:
        input("Press Enter to close")
    except EOFError:
        pass
    sys.exit(code)


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "check":
        st = check(offline="--offline" in a)
        if "--json" in a:
            print(json.dumps(st))
        elif st["update"]:
            extra = (" (%d new changes)" % st["changes"]) if st["latest"] == st["installed"] and st["changes"] else ""
            print("Update V%s is available%s (you have V%s). Run: rice-update" % (st["latest"], extra, st["installed"]))
            for n in st["news"]:
                print("  - " + n)
        else:
            print("Up to date: V%s%s" % (st["installed"], ("  (could not check: %s)" % st["error"]) if st["error"] else ""))
    elif cmd == "watch":
        watch()
    elif cmd == "ensure-watch":
        start_watch()
    elif cmd == "settings":
        try:
            prefs = set_preference(a[2], a[3]) if len(a) == 4 else preferences()
            print(json.dumps(prefs))
        except (ValueError, OSError) as e:
            print(str(e), file=sys.stderr)
            sys.exit(1)
    elif cmd == "notify":
        st = check(offline="--offline" in a)
        if not st["news"]:
            st["news"] = ["This is how the update notification looks"]
        notify_bg(st)
    elif cmd in ("", "run"):
        run(a[2:])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__)
    else:
        run(a[1:])   # pass flags like --no-packages on to install.sh


if __name__ == "__main__":
    main(sys.argv)
