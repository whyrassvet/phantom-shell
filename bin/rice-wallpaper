#!/usr/bin/env bash
# Wallpaper menu. Uses hyprquickpaper (Quickshell) if present, then waypaper.
qp="$HOME/.config/quickshell/hyprquickpaper"
if [ -f "$qp/shell.qml" ] && command -v qs >/dev/null 2>&1; then
  pgrep -f "quickshell/hyprquickpaper" >/dev/null && exit 0
  exec qs -n -p "$qp"
fi
if command -v waypaper >/dev/null 2>&1; then
  exec waypaper
fi
echo "rice-wallpaper: hyprquickpaper or waypaper is required" >&2
exit 1
