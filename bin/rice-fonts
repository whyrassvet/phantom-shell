#!/usr/bin/env bash
# Installs the fonts Phantom Shell uses (Inter, Rubik, Material Symbols Rounded and the six
# lock screen clock fonts) for the current user.
# Works on any distro (NixOS too): files go to ~/.local/share/fonts, no root needed.
#   rice-fonts           install what is missing
#   rice-fonts status    show what is installed
set -euo pipefail
dir="$HOME/.local/share/fonts/shadows-shell"
INTER_URL="https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip"
RUBIK_URL="https://raw.githubusercontent.com/google/fonts/main/ofl/rubik/Rubik%5Bwght%5D.ttf"
# icons of the dashboard (the same set Caelestia and end4 use)
SYMBOLS_URL="https://raw.githubusercontent.com/google/material-design-icons/master/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf"

has() {
  local fams
  fams="$(fc-list : family 2>/dev/null || true)"
  grep -qiE "(^|,)$1( |,|$)" <<<"$fams"
}

# lock screen clock fonts (Settings > Idle & Lockscreen > Clock font), all SIL Open Font License
GF="https://raw.githubusercontent.com/google/fonts/main/ofl"
CLOCK_FONTS=(
  "Bebas Neue|$GF/bebasneue/BebasNeue-Regular.ttf|BebasNeue.ttf"
  "Orbitron|$GF/orbitron/Orbitron%5Bwght%5D.ttf|Orbitron-Variable.ttf"
  "Outfit|$GF/outfit/Outfit%5Bwght%5D.ttf|Outfit-Variable.ttf"
  "Space Grotesk|$GF/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf|SpaceGrotesk-Variable.ttf"
  "Unbounded|$GF/unbounded/Unbounded%5Bwght%5D.ttf|Unbounded-Variable.ttf"
  "Big Shoulders Display|$GF/bigshouldersdisplay/BigShouldersDisplay%5Bwght%5D.ttf|BigShouldersDisplay-Variable.ttf"
)

if [ "${1:-}" = "status" ]; then
  for f in Inter Rubik "Material Symbols Rounded" "Bebas Neue" Orbitron Outfit "Space Grotesk" Unbounded "Big Shoulders Display"; do if has "$f"; then echo "$f: installed"; else echo "$f: missing"; fi; done
  exit 0
fi

command -v curl >/dev/null || { echo "rice-fonts: curl is needed" >&2; exit 1; }
mkdir -p "$dir"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
changed=0

if has Inter; then
  echo "Inter: already installed"
else
  echo "Inter: downloading..."
  curl -fsSL -o "$tmp/inter.zip" "$INTER_URL"
  python3 - "$tmp/inter.zip" "$dir" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
for n in ("InterVariable.ttf", "InterVariable-Italic.ttf"):
    open(sys.argv[2] + "/" + n, "wb").write(z.read(n))
PY
  changed=1
fi

if has Rubik; then
  echo "Rubik: already installed"
else
  echo "Rubik: downloading..."
  curl -fsSL -o "$dir/Rubik-Variable.ttf" "$RUBIK_URL"
  changed=1
fi

if has "Material Symbols Rounded"; then
  echo "Material Symbols Rounded: already installed"
else
  echo "Material Symbols Rounded: downloading..."
  if curl -fsSL -o "$tmp/symbols.ttf" "$SYMBOLS_URL" && [ "$(head -c 4 "$tmp/symbols.ttf" | od -An -tx1 | tr -d ' ')" = "00010000" ]; then
    mv "$tmp/symbols.ttf" "$dir/MaterialSymbolsRounded.ttf"
    changed=1
  else
    echo "Material Symbols Rounded: could not download (the dashboard uses Nerd Font icons instead)"
  fi
fi

# icons: JetBrains Mono Nerd Font and Symbols Nerd Font (packaged on Arch and NixOS, not on Fedora)
NF="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"
for e in "JetBrainsMono Nerd Font|JetBrainsMono|JetBrainsMonoNerdFont-*.ttf" "Symbols Nerd Font|NerdFontsSymbolsOnly|SymbolsNerdFont-*.ttf"; do
  IFS='|' read -r fam pkg pat <<<"$e"
  if has "$fam"; then
    echo "$fam: already installed"
  elif command -v tar >/dev/null && curl -fsSL -o "$tmp/$pkg.tar.xz" "$NF/$pkg.tar.xz" &&
       mkdir -p "$dir/$pkg" && tar -xJf "$tmp/$pkg.tar.xz" -C "$dir/$pkg" --wildcards "$pat" 2>/dev/null; then
    echo "$fam: installed"
    changed=1
  else
    echo "$fam: could not download (icons may show as boxes)"
  fi
done

# the CachyOS logo (U+F385) needs Nerd Fonts 3.4 or newer: with an older icon font it shows as a box
# (only Nerd Fonts count: Material Symbols and Unifont use the same code range for other pictures)
if command -v fc-list >/dev/null && ! fc-list ':charset=f385' family 2>/dev/null | grep -qi 'nerd'; then
  echo "Logo icons (CachyOS): your Nerd Font is older, downloading the newest icons..."
  if command -v tar >/dev/null && curl -fsSL -o "$tmp/logos.tar.xz" "$NF/NerdFontsSymbolsOnly.tar.xz" &&
     mkdir -p "$dir/NerdFontsSymbolsOnly" && tar -xJf "$tmp/logos.tar.xz" -C "$dir/NerdFontsSymbolsOnly" --wildcards "SymbolsNerdFont-*.ttf" 2>/dev/null; then
    echo "Logo icons: installed"
    changed=1
  else
    echo "Logo icons: could not download (the CachyOS logo may show as a box)"
  fi
fi

for e in "${CLOCK_FONTS[@]}"; do
  IFS='|' read -r fam url file <<<"$e"
  if has "$fam"; then
    echo "$fam: already installed"
  elif curl -fsSL -o "$tmp/clock.ttf" "$url" && [ "$(head -c 4 "$tmp/clock.ttf" | od -An -tx1 | tr -d ' ')" = "00010000" ]; then
    mv "$tmp/clock.ttf" "$dir/$file"
    echo "$fam: installed (lock screen clock)"
    changed=1
  else
    echo "$fam: could not download (the lock screen clock uses your Numbers font instead)"
  fi
done

if [ "$changed" = 1 ]; then
  fc-cache -f "$dir" >/dev/null 2>&1 || true
  echo "Done. Fonts are in $dir"
fi
