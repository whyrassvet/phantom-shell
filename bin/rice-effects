#!/usr/bin/env python3
"""rice-effects: blur, transparency and gaming mode for the whole shell (Settings > Services).

  rice-effects state                    JSON: {lite, gaming, flat, opts}
  rice-effects lite on|off|toggle       Light mode for slower computers: no blur, no transparency, no shadows
                                        (animations stay), the visualizer stops and widgets pause while a window covers them
  rice-effects gaming on|off|toggle     gaming mode (hot corner, Settings > Services)
  rice-effects set KEY on|off           gaming mode options: keep_blur keep_anim keep_gaps keep_shadows dnd edge
  rice-effects apply                    write everything again (the installer runs this)
  rice-effects flat                     exit 0 when blur and transparency are off right now

"Flat" (no blur, no transparency) is on when Lite is on, or when gaming mode is on and
"Keep blur & transparency" is off. It reaches:
  Hyprland (blur off, every window opaque), kitty (background_opacity 1), Waybar,
  notifications (swaync), the dashboard, the hot corner, the dock and the desktop widgets.
Gaming mode also turns off animations, shadows and gaps (unless you keep them), can turn on
Do Not Disturb, and stops the dashboard from opening at the bottom edge.
Undo: rice-effects lite off; rice-effects gaming off.
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/effects.json"
GAMING_ON = DIR + "/gaming-on"          # this computer is in gaming mode right now (not synced)
CACHE = HOME + "/.cache/rice"
FLAT = CACHE + "/flat"                  # exists while blur and transparency are off
LITE = CACHE + "/lite"                  # exists while Light mode is on (the desktop widgets read it)
DND_BY_US = CACHE + "/gaming-dnd"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-gaming.lua"
HLUA = HYPR + "/hyprland.lua"
KITTY = HOME + "/.config/kitty"
KITTY_FLAT = KITTY + "/rice-flat.conf"
KITTY_LINE = "globinclude rice-flat.conf"
BIN = HOME + "/.local/bin"

DEFAULTS = {"lite": False, "keep_blur": False, "keep_anim": False, "keep_gaps": False,
            "keep_shadows": False, "dnd": False, "edge": False}
OPTS = ("keep_blur", "keep_anim", "keep_gaps", "keep_shadows", "dnd", "edge")


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
        for k in DEFAULTS:
            if k in raw:
                c[k] = raw[k] is True
    except Exception:
        pass
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, CFG)


def gaming_on():
    if os.path.exists(GAMING_ON):
        return True
    try:   # gaming mode from an older version (hot corner)
        return "Gaming mode from the hot corner" in open(LUA).read()
    except Exception:
        return False


def flat(c=None):
    c = c or load()
    return c["lite"] or (gaming_on() and not c["keep_blur"])


def state():
    c = load()
    return {"lite": c["lite"], "gaming": gaming_on(), "flat": flat(c), "opts": {k: c[k] for k in OPTS}}


def q(cmd, timeout=8):
    if not shutil.which(cmd[0]) and not os.path.exists(cmd[0]):
        return
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
    except Exception:
        pass


def bg(cmd):
    if not shutil.which(cmd[0]) and not os.path.exists(cmd[0]):
        return
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def notify(title, body):
    bg(["notify-send", "-a", "Phantom Shell", "-h", "boolean:resident:true", "-i", "input-gaming", title, body])


# ---------------- Hyprland ----------------
def lua_text(c):
    g = gaming_on()
    fl = flat(c)
    out = ["-- generated by rice-effects (Settings > Services). Loaded last, so it wins.\n"]
    if fl:
        out.append("-- no blur, no transparency\n"
                   "pcall(hl.config, { decoration = { blur = { enabled = false } } })\n"
                   "pcall(hl.config, { decoration = { active_opacity = 1.0, inactive_opacity = 1.0, fullscreen_opacity = 1.0 } })\n"
                   'pcall(hl.window_rule, { name = "rice-flat-opaque", match = { class = ".*" }, opacity = "1.0 override 1.0 override" })\n')
    if c["lite"]:
        out.append("-- Light mode: no shadows (animations stay)\n"
                   "pcall(hl.config, { decoration = { shadow = { enabled = false } } })\n")
    if g:
        out.append("-- gaming mode\n")
        if not c["keep_anim"]:
            out.append("pcall(hl.config, { animations = { enabled = false } })\n")
        if not c["keep_shadows"]:
            out.append("pcall(hl.config, { decoration = { shadow = { enabled = false } } })\n")
        if not c["keep_gaps"]:
            out.append("pcall(hl.config, { general = { gaps_in = 0, gaps_out = 0 } })\n")
    if not fl and not g and not c["lite"]:
        out.append("-- nothing is changed right now\n")
    return "".join(out)


def wire_hypr():
    try:
        s = open(HLUA).read()
    except FileNotFoundError:
        return
    if 'require("rice-gaming")' in s:
        # keep it the last line, so it wins over everything
        lines = s.rstrip("\n").split("\n")
        if lines[-1].strip() == 'require("rice-gaming")':
            return
        drop = ('require("rice-gaming")', "-- must stay last: gaming mode overrides",
                '-- must stay last: gaming mode and "no blur & transparency" override')
        n = "\n".join(l for l in lines if l.strip() not in drop).rstrip("\n")
    else:
        n = s.rstrip("\n")
        if not os.path.exists(HLUA + ".bak-gaming"):
            shutil.copy2(HLUA, HLUA + ".bak-gaming")
    open(HLUA, "w").write(n + '\n\n-- must stay last: gaming mode and "no blur & transparency" override\nrequire("rice-gaming")\n')


# ---------------- kitty ----------------
def kitty(fl):
    if not os.path.isdir(KITTY):
        return
    open(KITTY_FLAT, "w").write(
        "# generated by rice-effects (Settings > Services)\n"
        "dynamic_background_opacity yes\n" + ("background_opacity 1.0\n" if fl else ""))
    conf = KITTY + "/kitty.conf"
    try:
        s = open(conf).read()
    except FileNotFoundError:
        s = ""
    mark = "# Phantom Shell: blur & transparency switch (keep last)"
    old_mark = "# DarkShadow's Shell: blur & transparency switch (keep last)"
    lines = [l for l in s.split("\n") if l.strip() not in (KITTY_LINE, mark, old_mark)]
    n = ("\n".join(lines).rstrip("\n") + "\n\n" if "".join(lines).strip() else "") + mark + "\n" + KITTY_LINE + "\n"
    if n != s:
        if s and not os.path.exists(conf + ".bak-effects"):
            open(conf + ".bak-effects", "w").write(s)
        open(conf, "w").write(n)
    # running kitty windows read the config again
    for name in ("kitty", ".kitty-wrapped"):
        q(["pkill", "-USR1", "-x", name], timeout=3)


def apply(c, reload_hypr=True, quiet=False):
    os.makedirs(CACHE, exist_ok=True)
    fl = flat(c)
    if fl:
        open(FLAT, "w").write("1\n")
    elif os.path.exists(FLAT):
        os.remove(FLAT)
    if c["lite"]:
        open(LITE, "w").write("1\n")
    elif os.path.exists(LITE):
        os.remove(LITE)
    os.makedirs(HYPR, exist_ok=True)
    old = open(LUA).read() if os.path.exists(LUA) else ""
    new = lua_text(c)
    if new != old:
        open(LUA, "w").write(new)
    wire_hypr()
    kitty(fl)
    # the parts that draw their own see-through backgrounds
    for cmd in ([BIN + "/waybar-set", "reapply"], [BIN + "/rice-notify", "apply"]):
        if os.path.exists(cmd[0]):
            q(cmd, timeout=20)
    # the dashboard reads its settings again when this file changes
    try:
        os.utime(DIR + "/dashboard.json")
    except Exception:
        pass
    if reload_hypr:
        q(["hyprctl", "reload"])


def set_dnd(on):
    if on:
        q(["swaync-client", "-dn"])
        open(DND_BY_US, "w").write("1\n")
    elif os.path.exists(DND_BY_US):
        os.remove(DND_BY_US)
        q(["swaync-client", "-df"])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "state"
    arg = argv[2] if len(argv) > 2 else ""
    c = load()
    if cmd == "state":
        print(json.dumps(state()))
    elif cmd == "flat":
        sys.exit(0 if flat(c) else 1)
    elif cmd == "apply":
        apply(c, reload_hypr="--no-reload" not in argv)
    elif cmd == "lite":
        on = (not c["lite"]) if arg == "toggle" else arg == "on"
        if arg not in ("on", "off", "toggle"):
            sys.exit("usage: rice-effects lite on|off|toggle")
        c["lite"] = on
        save(c)
        apply(c)
        notify("Light mode " + ("on" if on else "off"),
               "No blur, no shadows, calmer widgets. Animations stay. Lighter on slower computers." if on else "Blur, transparency and shadows are back.")
    elif cmd == "gaming":
        if arg not in ("on", "off", "toggle"):
            sys.exit("usage: rice-effects gaming on|off|toggle")
        on = (not gaming_on()) if arg == "toggle" else arg == "on"
        os.makedirs(DIR, exist_ok=True)
        if on:
            open(GAMING_ON, "w").write("1\n")
        elif os.path.exists(GAMING_ON):
            os.remove(GAMING_ON)
        apply(c)
        if c["dnd"] or not on:
            set_dnd(on and c["dnd"])
        off = []
        if not c["keep_anim"]:
            off.append("animations")
        if not c["keep_blur"]:
            off.append("blur & transparency")
        if not c["keep_shadows"]:
            off.append("shadows")
        if not c["keep_gaps"]:
            off.append("gaps")
        what = ", ".join(off) if off else "nothing (you keep everything)"
        notify("Gaming mode " + ("on" if on else "off"), ("Off now: " + what) if on else "Everything is back")
    elif cmd == "set":
        if arg not in OPTS or len(argv) < 4:
            sys.exit("usage: rice-effects set %s on|off" % "|".join(OPTS))
        c[arg] = argv[3].lower() in ("1", "on", "true", "yes")
        save(c)
        if gaming_on():
            apply(c)
            if arg == "dnd":
                set_dnd(c["dnd"])
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
