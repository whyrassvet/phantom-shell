#!/usr/bin/env python3
import fcntl
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/desktop.json"
LOCK = DIR + "/.desktop.lock"
LOCKCONF = HOME + "/.config/hypr/rice-lock.conf"
HYPRLOCK = HOME + "/.config/hypr/hyprlock.conf"
SOURCE_LINE = "source = ~/.config/hypr/rice-lock.conf"

WIDGETS = ["weather", "media", "resources", "usercard", "calendar", "visualizer", "battery"]
# what the widget editor stores per widget (Settings > Desktop > Edit widgets, or SUPER+ALT+W)
GEOM = ("x", "y", "scale", "w", "h", "opacity", "bg", "style", "flip")
STYLES = {"visualizer": ["bars", "mirror", "wave", "dots"], "clock": ["digital", "cookie", "pixel"]}
DEFAULTS = {
    "widgets": {w: {"enabled": False} for w in WIDGETS},
    "clock": {"enabled": False, "onlyLocked": False, "placement": "draggable", "style": "digital"},
    "dock": {"enabled": False, "background": True, "hover": True, "pinnedStartup": False,
             "media": True, "pinButton": True, "appsButton": True, "tint": False,
             "opacity": 0.78, "blur": True,
             "apps": ["kitty", "org.gnome.Nautilus", "firefox", "spotify", "discord", "steam"]},
    "lock": {"toolbars": False, "widgets": False, "media": False},
    "widgetBlur": True,
    "autoHide": True,        # widgets hide while windows are open (Settings > Desktop)
    "editing": False,
}
CHOICES = {"placement": ["draggable", "leastBusy", "mostBusy"], "style": ["digital", "cookie", "pixel"]}


def target(c, wid):
    if wid == "clock":
        return c["clock"]
    if wid not in c["widgets"]:
        die("unknown widget: " + wid + "  (" + ", ".join(WIDGETS + ["clock"]) + ")")
    return c["widgets"][wid]


def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def merge(base, over):
    out = {}
    for k, v in base.items():
        if isinstance(v, dict):
            out[k] = merge(v, over.get(k, {}) if isinstance(over.get(k), dict) else {})
        else:
            out[k] = over[k] if k in over else v
    for k, v in over.items():
        if k not in out and k in GEOM:
            out[k] = v
    return out


def load():
    try:
        raw = json.load(open(CFG))
    except Exception:
        raw = {}
    c = merge(DEFAULTS, raw)
    # keep saved positions, sizes and looks
    for w in WIDGETS + ["clock"]:
        if w == "clock":
            src, dst = raw.get("clock", {}), c["clock"]
        else:
            src = raw.get("widgets", {}).get(w, {}) if isinstance(raw.get("widgets"), dict) else {}
            dst = c["widgets"][w]
        if not isinstance(src, dict):
            continue
        for k in GEOM:
            if k in src:
                v = clean_geom(w, k, src[k])
                if v is not None:
                    dst[k] = v
                else:
                    dst.pop(k, None)
    if isinstance(raw.get("dock", {}).get("apps"), list):
        c["dock"]["apps"] = [str(a) for a in raw["dock"]["apps"]]
    return c


def clean_geom(wid, k, v):
    try:
        if k in ("x", "y"):
            return int(max(0, float(v)))
        if k in ("w", "h"):
            return int(max(40, min(8000, float(v))))
        if k == "scale":
            return round(max(0.4, min(3.0, float(v))), 3)
        if k in ("opacity", "bg"):
            return round(max(0.0 if k == "bg" else 0.1, min(1.0, float(v))), 2)
        if k == "flip":
            return v is True or str(v).lower() in ("1", "true", "on", "yes")
        if k == "style":
            return v if v in STYLES.get(wid, []) else None
    except (TypeError, ValueError):
        return None
    return None


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f, indent=2)
    os.replace(tmp, CFG)


def tobool(v):
    return str(v).lower() in ("1", "true", "on", "yes")


def lock_conf(c):
    L = ["# generated by desktop-set (Settings > Interface > Lock screen). Do not edit."]
    font = "JetBrainsMono Nerd Font"
    col = "rgba(246, 245, 244, 0.9)"

    def label(text, size, y):
        return ["label {", "    monitor =", "    text = " + text, "    color = " + col,
                "    font_size = %d" % size, "    font_family = " + font,
                "    position = 0, %d" % y, "    halign = center", "    valign = bottom", "}"]
    lk = c["lock"]
    if lk["toolbars"]:
        L += label("cmd[update:30000] echo \"$(date '+%A, %d %B')  ·  up $(uptime -p | sed 's/^up //')\"", 14, 36)
    if lk["widgets"]:
        L += label("cmd[update:3000] ~/.local/bin/rice-sysline", 16, 70)
    if lk["media"]:
        L += label("cmd[update:1500] ~/.local/bin/rice-nowplaying", 15, 110)
    os.makedirs(os.path.dirname(LOCKCONF), exist_ok=True)
    tmp = LOCKCONF + ".tmp"
    open(tmp, "w").write("\n".join(L) + "\n")
    os.replace(tmp, LOCKCONF)
    try:
        s = open(HYPRLOCK).read()
        if "rice-lock.conf" not in s:
            if not os.path.exists(HYPRLOCK + ".bak-rice"):
                open(HYPRLOCK + ".bak-rice", "w").write(s)
            open(HYPRLOCK, "w").write(s.rstrip() + "\n\n" + SOURCE_LINE + "\n")
    except FileNotFoundError:
        pass


def dock_blur(c):
    """Blur behind the dock and the desktop widgets: Hyprland layer rules in rice-dock.lua, so the switches can turn them off."""
    hypr = HOME + "/.config/hypr"
    lua, main = hypr + "/rice-dock.lua", hypr + "/hyprland.lua"
    text = "-- generated by desktop-set (Settings > Interface > Dock, Settings > Desktop > Widgets)\n"
    if c["dock"].get("blur", True):
        text += ('hl.layer_rule({\n    name  = "rice-dock-blur",\n    match = { namespace = "rice-dock" },\n'
                 '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    if c.get("widgetBlur", True):
        # only where a card is (the rest of the widget surface is fully clear)
        text += ('hl.layer_rule({\n    name  = "rice-widget-blur",\n    match = { namespace = "rice-widget" },\n'
                 '    blur = true,\n    ignore_alpha = 0.2,\n})\n')
    os.makedirs(hypr, exist_ok=True)
    open(lua, "w").write(text)
    try:
        s = open(main).read()
        import re
        n = re.sub(r'hl\.layer_rule\(\{\s*name\s*=\s*"rice-dock-blur",.*?\}\)\n?\n?', "", s, flags=re.S)
        if 'require("rice-dock")' not in n:
            a = 'require("rice-settings")'
            n = n.replace(a, a + '\nrequire("rice-dock")') if n.count(a) == 1 else n.rstrip("\n") + '\nrequire("rice-dock")\n'
        if n != s:
            if not os.path.exists(main + ".bak-dock"):
                open(main + ".bak-dock", "w").write(s)
            open(main, "w").write(n)
    except FileNotFoundError:
        pass
    try:
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except Exception:
        pass


def ensure_shell():
    try:
        subprocess.Popen([HOME + "/.local/bin/rice-desktop", "ensure"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def main(a):
    if len(a) < 2:
        die("usage: desktop-set state|widget ID on|off|pos ID X Y|geom ID X Y [SCALE] [W H]|wset ID KEY VAL|"
            "reset-widget ID|edit on|off|toggle|clock KEY VAL|dock KEY VAL|lock KEY VAL|dock-blur|widgets-blur on|off|auto-hide on|off|reset-pos")
    cmd = a[1]
    os.makedirs(DIR, exist_ok=True)
    lk = open(LOCK, "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    c = load()
    if cmd == "state":
        if not os.path.exists(CFG):
            save(c)
        print(json.dumps(c))
        return
    if cmd == "widget":
        if len(a) < 4 or a[2] not in WIDGETS:
            die("widget: " + "|".join(WIDGETS) + " on|off")
        c["widgets"][a[2]]["enabled"] = tobool(a[3])
    elif cmd == "pos":
        if len(a) < 5:
            die("pos ID X Y")
        tgt = c["clock"] if a[2] == "clock" else c["widgets"].get(a[2])
        if tgt is None:
            die("unknown id: " + a[2])
        tgt["x"], tgt["y"] = max(0, int(float(a[3]))), max(0, int(float(a[4])))
    elif cmd == "clock":
        if len(a) < 4:
            die("clock KEY VALUE")
        k, v = a[2], a[3]
        if k in ("enabled", "onlyLocked"):
            c["clock"][k] = tobool(v)
        elif k in CHOICES:
            if v not in CHOICES[k]:
                die("%s: %s" % (k, "|".join(CHOICES[k])))
            c["clock"][k] = v
        else:
            die("unknown clock key: " + k)
    elif cmd in ("dock", "lock"):
        if len(a) < 4 or a[2] not in c[cmd] or a[2] == "apps":
            die("%s KEY on|off (keys: %s)" % (cmd, ", ".join(k for k in c[cmd] if k != "apps")))
        if cmd == "dock" and a[2] == "opacity":
            c["dock"]["opacity"] = round(max(0.2, min(1.0, float(a[3]))), 2)
        else:
            c[cmd][a[2]] = tobool(a[3])
    elif cmd in ("lock-regen", "dock-blur"):
        pass
    elif cmd == "widgets-blur":
        c["widgetBlur"] = tobool(a[2] if len(a) > 2 else "on")
    elif cmd == "auto-hide":
        c["autoHide"] = tobool(a[2] if len(a) > 2 else "on")
    elif cmd == "geom":
        # geom ID X Y [SCALE] [W H]
        if len(a) < 5:
            die("geom ID X Y [SCALE] [W H]")
        t = target(c, a[2])
        for k, i in (("x", 3), ("y", 4), ("scale", 5), ("w", 6), ("h", 7)):
            if len(a) > i and a[i] not in ("", "-"):
                v = clean_geom(a[2], k, a[i])
                if v is not None:
                    t[k] = v
        if a[2] == "clock":
            c["clock"]["placement"] = "draggable"
    elif cmd == "wset":
        # wset ID KEY VALUE   (opacity, bg, style, flip, scale, w, h, x, y)
        if len(a) < 5 or a[3] not in GEOM:
            die("wset ID KEY VALUE   keys: " + " ".join(GEOM))
        t = target(c, a[2])
        v = clean_geom(a[2], a[3], a[4])
        if v is None:
            die("bad value for %s: %s" % (a[3], a[4]))
        t[a[3]] = v
    elif cmd == "reset-widget":
        t = target(c, a[2] if len(a) > 2 else "")
        for k in GEOM:
            if k != "style":
                t.pop(k, None)
    elif cmd == "edit":
        v = a[2] if len(a) > 2 else "toggle"
        c["editing"] = (not c.get("editing")) if v == "toggle" else tobool(v)
    elif cmd == "reset-pos":
        for w in WIDGETS:
            for k in ("x", "y", "scale", "w", "h"):
                c["widgets"][w].pop(k, None)
        for k in ("x", "y", "scale", "w", "h"):
            c["clock"].pop(k, None)
    else:
        die("unknown command: " + cmd)
    save(c)
    if cmd in ("lock", "lock-regen"):
        lock_conf(c)
    if cmd == "dock" and a[2] == "blur" or cmd in ("dock-blur", "widgets-blur"):
        dock_blur(c)
    elif cmd not in ("pos", "geom", "wset", "edit", "reset-widget"):
        ensure_shell()
    elif cmd == "edit" and c["editing"]:
        ensure_shell()


main(sys.argv)
