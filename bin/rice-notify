#!/usr/bin/env python3
"""rice-notify: Phantom notification popup settings. Settings > Notifications.

  rice-notify state | set KEY VALUE | apply | reset | test
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
# swaync may run with a short PATH (started by D-Bus or systemd): its scripts go through rice-run.
# "exec": swaync's own /bin/sh becomes rice-run, so its output pipe closes at once (swaync 0.12 crash)
RUN = "exec /bin/sh " + HOME + "/.local/bin/rice-run"
CFG = DIR + "/notify.json"
FONTS = DIR + "/fonts.json"
SW = HOME + "/.config/swaync"
SWCFG = SW + "/config.json"
SWCSS = SW + "/style.css"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-notify.lua"
HLUA = HYPR + "/hyprland.lua"
WAYBAR_COLORS = HOME + "/.config/waybar/colors.css"
BEGIN, END = "/* rice-notify */", "/* end-rice-notify */"

DEFAULTS = {
    "pos_x": "center", "pos_y": "top",
    "popup_width": 360, "timeout": 6, "critical_sticky": True, "icon_size": 42, "images": True,
    "popup_style": "glass", "accent": True,
    "colors": "black", "font": "rounded", "font_size": 14, "popup_opacity": 0.3, "blur_popups": True,
    "border": "subtle", "shadow": False,
    "sound": "glass", "sound_volume": 70,
}
INTS = {"popup_width": (260, 600),
        "timeout": (2, 30), "icon_size": (20, 72), "font_size": (10, 18),
        "sound_volume": (0, 100)}
FLOATS = {"popup_opacity": (0.3, 1.0)}
CHOICES = {"pos_x": ["left", "center", "right"], "pos_y": ["top", "bottom"],
           "popup_style": ["glass", "solid", "minimal", "pill", "accent", "glow", "island", "light"],
           "colors": ["black", "graphite", "slate", "white", "tinted"], "font": ["sans", "rounded", "mono", "system"],
           "border": ["subtle", "accent", "none"],
           "sound": ["glass", "droplet", "chime", "bubble", "marimba", "aurora", "ping", "harp", "keys", "ripple", "off"]}



def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
    except Exception:
        raw = {}
    for k, d in DEFAULTS.items():
        v = raw.get(k, d)
        if isinstance(d, bool):
            c[k] = v is True
        elif k in CHOICES:
            c[k] = v if v in CHOICES[k] else d
        elif k in FLOATS:
            try:
                c[k] = round(clamp(float(v), *FLOATS[k]), 2)
            except Exception:
                c[k] = d
        else:
            try:
                c[k] = int(clamp(float(v), *INTS[k]))
            except Exception:
                c[k] = d
    # Migrate the old panel-dependent popup look without retaining panel settings.
    if raw.get("popup_style") == "match":
        c["popup_style"] = raw.get("style") if raw.get("style") in ("glass", "solid") else "glass"
    c["v"] = 3
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, CFG)


def accent():
    try:
        s = open(WAYBAR_COLORS).read()
        a = re.search(r"@define-color\s+accent\s+#([0-9a-fA-F]{6})", s)
        o = re.search(r"@define-color\s+on_accent\s+#([0-9a-fA-F]{6})", s)
        return "#" + (a.group(1) if a else "d4d4d4"), "#" + (o.group(1) if o else "0d0d0d")
    except Exception:
        return "#d4d4d4", "#0d0d0d"


FONT_STACKS = {
    "sans": '"Inter", "Inter Variable", "Rubik", "Noto Sans", "Cantarell", "Symbols Nerd Font", "JetBrainsMono Nerd Font", sans-serif',
    "rounded": '"Rubik", "Nunito", "Quicksand", "Inter", "Noto Sans", "Symbols Nerd Font", "JetBrainsMono Nerd Font", sans-serif',
    "mono": '"JetBrainsMono Nerd Font", "JetBrains Mono", monospace',
}


def font(c):
    if c["font"] in FONT_STACKS:
        return FONT_STACKS[c["font"]]
    try:
        f = json.load(open(FONTS))
        return '"%s", "Symbols Nerd Font", sans-serif' % (f.get("main") or "Noto Sans").replace('"', "")
    except Exception:
        return "sans-serif"


def palette(c, acc):
    """base surface rgb, text, secondary text, card overlay"""
    k = c["colors"]
    if k == "black":
        return (0, 0, 0), "#F6F5F4", "#9a9aa4", "rgba(255, 255, 255, 0.07)"
    if k == "slate":
        return (24, 27, 34), "#EEF1F6", "#9aa4b5", "rgba(255, 255, 255, 0.06)"
    if k == "white":
        return (246, 245, 244), "#141414", "#5c5c64", "rgba(0, 0, 0, 0.05)"
    if k == "tinted":
        h = acc.lstrip("#")
        try:
            a = tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
        except Exception:
            a = (212, 212, 212)
        return tuple(int(14 + (x - 14) * 0.14) for x in a), "#F6F5F4", "#a8a8b4", "rgba(255, 255, 255, 0.07)"
    return (18, 18, 20), "#F6F5F4", "#9a9aa4", "rgba(255, 255, 255, 0.06)"


def backup_once(path, suf):
    if os.path.exists(path) and not os.path.exists(path + suf):
        shutil.copy2(path, path + suf)


# ---------------- config.json ----------------
def write_config(c):
    try:
        j = json.load(open(SWCFG))
    except FileNotFoundError:
        j = {"$schema": "/etc/xdg/swaync/configSchema.json"}
    except Exception as e:
        die("swaync config.json is not valid JSON, not touching it: %s" % e)
    backup_once(SWCFG, ".bak-rice-notify")
    j["positionX"] = c["pos_x"]          # popups: left, center or right
    j["positionY"] = c["pos_y"]
    j["notification-window-width"] = c["popup_width"]
    j["timeout"] = c["timeout"]
    j["timeout-low"] = max(2, c["timeout"] // 2)
    j["timeout-critical"] = 0 if c["critical_sticky"] else c["timeout"]
    j["notification-icon-size"] = c["icon_size"]
    j["image-visibility"] = "when-available" if c["images"] else "never"
    # sound for new notifications: swaync runs rice-sound, which checks Do Not Disturb itself
    scripts = j.get("scripts") if isinstance(j.get("scripts"), dict) else {}
    scripts.pop("rice-sound", None)
    if c["sound"] != "off":
        scripts["rice-sound"] = {"exec": RUN + " rice-sound notify", "app-name": ".*", "run-on": "receive"}
    scripts.pop("rice-keep", None)
    vis = j.get("notification-visibility")
    if isinstance(vis, dict):
        vis.pop("rice-kept", None)
        if not vis:
            j.pop("notification-visibility", None)
    if scripts:
        j["scripts"] = scripts
    else:
        j.pop("scripts", None)
    j["script-fail-notify"] = False
    tmp = SWCFG + ".tmp"
    os.makedirs(SW, exist_ok=True)
    json.dump(j, open(tmp, "w"), indent=2, ensure_ascii=False)
    os.replace(tmp, SWCFG)


def css(c):
    acc, on_acc = accent() if c["accent"] else ("#F6F5F4", "#0d0d0d")
    base, fg, dim, _ = palette(c, acc)
    light = c["colors"] == "white"
    edge = acc if c["border"] == "accent" else "transparent" if c["border"] == "none" else ("rgba(0, 0, 0, 0.10)" if light else "rgba(255, 255, 255, 0.09)")
    popup = "rgba(%d, %d, %d, %.2f)" % (*base, c["popup_opacity"])
    shadow = "0 2px 6px rgba(0, 0, 0, 0.30)" if c["shadow"] else "none"
    p = ".floating-notifications .notification-row .notification-background .notification"
    return (BEGIN + "\n" + """/* Popup styles generated by rice-notify. */
.floating-notifications, .blank-window { background: transparent; font-family: %s; font-size: %dpx; }
.floating-notifications * { font-family: %s; }
.floating-notifications .notification-row, .floating-notifications .notification-background,
%s .notification-default-action, %s .notification-content { background: transparent; box-shadow: none; border: none; }
%s { background: %s; color: %s; border: 1px solid %s; border-radius: 18px; padding: 12px; box-shadow: %s; }
%s .summary { color: %s; font-weight: bold; }
%s .body, %s .time { color: %s; }
""" % (font(c), c["font_size"], font(c), p, p, p, popup, fg, edge, shadow, p, fg, p, p, dim)
            + popup_css(c, acc, on_acc) + "\n" + END + "\n")


def hex_rgba(h, a):
    h = h.lstrip("#")
    try:
        return "rgba(%d, %d, %d, %.2f)" % (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), a)
    except Exception:
        return "rgba(212, 212, 212, %.2f)" % a


def popup_css(c, acc, on_acc):
    """Extra look for popups."""
    st = c["popup_style"]
    base, fg, dim, _ = palette(c, acc)
    pop = c["popup_opacity"]

    def bgc(a):
        return "rgba(%d, %d, %d, %.2f)" % (base[0], base[1], base[2], a)

    P = ".floating-notifications .notification-row .notification-background .notification"
    r = 18
    line = "rgba(0, 0, 0, 0.08)" if c["colors"] == "white" else "rgba(255, 255, 255, 0.10)"
    rules = {
        "glass":   "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;" % (bgc(min(pop, 0.62)), line, r),
        "solid":   "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;" % (bgc(1.0), line, r),
        "minimal": "background: %s;\n  border: none;\n  border-radius: 8px;\n  padding: 8px 10px;" % bgc(pop),
        "pill":    "background: %s;\n  border: 1px solid %s;\n  border-radius: 999px;\n  padding: 6px 18px;" % (bgc(pop), line),
        "accent":  "background: %s;\n  border: 1px solid %s;\n  border-left: 4px solid %s;\n  border-radius: 10px;" % (bgc(pop), line, acc),
        "glow":    "background: %s;\n  border: 1px solid %s;\n  border-radius: %dpx;\n  box-shadow: 0 0 16px %s;" % (bgc(pop), acc, r, hex_rgba(acc, 0.45)),
        "island":  "background: rgb(0, 0, 0);\n  border: none;\n  border-radius: 28px;\n  padding: 12px 18px;",
        "light":   "background: rgba(246, 245, 244, %.2f);\n  border: 1px solid rgba(0, 0, 0, 0.08);\n  border-radius: %dpx;" % (max(pop, 0.9), r),
    }
    out = ["/* popup style: %s */" % st, "%s {\n  %s\n}" % (P, rules[st])]
    if st == "pill":
        out.append("%s .image, %s .app-icon {\n  border-radius: 999px;\n}" % (P, P))
    if st == "minimal":
        out.append("%s .summary {\n  font-size: 0.95em;\n}" % P)
    if st in ("light", "island"):
        tf, td = ("#111111", "#555555") if st == "light" else ("#F6F5F4", "#9a9aa4")
        out.append("%s .summary {\n  color: %s;\n}\n%s .body, %s .time {\n  color: %s;\n}" % (P, tf, P, P, td))
    if st == "light":
        out.append(".floating-notifications .notification-row .notification-background .close-button {\n"
                   "  background: rgba(0, 0, 0, 0.08);\n  color: #111111;\n}")
    return "\n".join(out)


def strong(text):
    # popups live in a window with both classes: ".floating-notifications.background".
    # Using both makes our rules beat themes that use the same long selectors.
    return text.replace(".floating-notifications .notification-row", ".floating-notifications.background .notification-row")


def flat():
    """rice-effects: blur and transparency are off right now (Lite, or gaming mode)"""
    return os.path.exists(os.path.expanduser("~/.cache/rice/flat"))


def write_css(c):
    if flat():
        c = dict(c, popup_opacity=1.0)
    s = open(SWCSS).read() if os.path.exists(SWCSS) else ""
    backup_once(SWCSS, ".bak-rice-notify")
    s = re.sub(r"\n?" + re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "\n", s, flags=re.S)
    os.makedirs(SW, exist_ok=True)
    tmp = SWCSS + ".tmp"
    open(tmp, "w").write(s.rstrip() + "\n\n" + strong(css(c)))
    os.replace(tmp, SWCSS)


# ---------------- blur (Hyprland layer rules) ----------------
def lua_text(c):
    out = ["-- generated by rice-notify (Settings > Notifications). Do not edit by hand.\n"]
    for ns, on in (("swaync-notification-window", c["blur_popups"]),):
        if on:
            out.append('hl.layer_rule({\n    name  = "rice-%s-blur",\n    match = { namespace = "%s" },\n'
                       '    blur = true,\n    ignore_alpha = 0.1,\n})\n' % (ns, ns))
    return "".join(out)


def wire_hypr():
    if not os.path.exists(HLUA):
        return False
    s = open(HLUA).read()
    n = re.sub(r'hl\.layer_rule\(\{\s*name\s*=\s*"swaync-blur",.*?\}\)\n?\n?', "", s, flags=re.S)
    if 'require("rice-notify")' not in n:
        a = 'require("rice-settings")'
        n = n.replace(a, a + '\nrequire("rice-notify")') if n.count(a) == 1 else n.rstrip("\n") + '\n\nrequire("rice-notify")\n'
    if n != s:
        backup_once(HLUA, ".bak-notify")
        open(HLUA, "w").write(n)
        return True
    return False


def quiet(cmd, timeout=6):
    if shutil.which(cmd[0]):
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)
        except subprocess.TimeoutExpired:
            pass


def apply(c, reload_hypr=False):
    write_config(c)
    write_css(c)
    old = open(LUA).read() if os.path.exists(LUA) else None
    new = lua_text(c)
    changed = old != new
    if changed:
        open(LUA, "w").write(new)
    if wire_hypr():
        changed = True
    quiet(["swaync-client", "-R"])
    quiet(["swaync-client", "-rs"])
    if changed or reload_hypr:
        quiet(["hyprctl", "reload"])


def test():
    # plain D-Bus call, works without notify-send
    quiet(["busctl", "--user", "call", "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
           "org.freedesktop.Notifications", "Notify", "susssasa{sv}i", "DarkShadow's Shell", "0",
           (HOME + "/.face") if os.path.exists(HOME + "/.face") else "dialog-information", "Hello from DarkShadow's Shell",
           "This is how your notifications look. Change them in Settings > Notifications.", "0", "0", "6000"])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "state":
        out = load()
        out["accent_color"], out["on_accent"] = accent()
        out["installed"] = shutil.which("swaync-client") is not None
        out["flat"] = flat()
        print(json.dumps(out))
        return
    if cmd == "test":
        test()
        return
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.notify.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    if cmd == "apply":
        pass  # Phantom watches notify.json directly; no SwayNC or Hyprland changes.
    elif cmd == "set":
        if len(argv) < 4 or argv[2] not in DEFAULTS:
            die("usage: rice-notify set KEY VALUE   keys: " + " ".join(DEFAULTS))
        k, v = argv[2], argv[3]
        c = load()
        d = DEFAULTS[k]
        if isinstance(d, bool):
            c[k] = v.lower() in ("1", "true", "on", "yes")
        elif k in CHOICES:
            if v not in CHOICES[k]:
                die("%s: %s" % (k, "|".join(CHOICES[k])))
            c[k] = v
        elif k in FLOATS:
            c[k] = round(clamp(float(v), *FLOATS[k]), 2)
        else:
            c[k] = int(clamp(float(v), *INTS[k]))
        save(c)
    elif cmd == "reset":
        if os.path.exists(CFG):
            os.remove(CFG)
        c = load()
        save(c)
    elif cmd == "restore":
        for p, b in ((SWCFG, ".bak-rice-notify"), (SWCSS, ".bak-rice-notify"), (HLUA, ".bak-notify")):
            if os.path.exists(p + b):
                shutil.copy2(p + b, p)
                print("restored", p)
        if os.path.exists(LUA):
            os.remove(LUA)
        quiet(["swaync-client", "-R"])
        quiet(["swaync-client", "-rs"])
        quiet(["hyprctl", "reload"])
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
