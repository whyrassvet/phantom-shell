#!/usr/bin/env python3
"""rice-sfx: interface sounds of Phantom Shell (Settings > Sfx & sounds).

  rice-sfx state                   JSON with the settings and the sound packs
  rice-sfx set KEY VALUE           enabled on|off, volume 0-100, pack (see PACKS),
                                   click|switch|slider|typing|music on|off
  rice-sfx play EVENT              play one sound now (respects the settings): click switch-on switch-off
                                   slide type select done, intro/night intro/reveal intro/open intro/tip
  rice-sfx music start|stop        quiet music for the welcome intro and the Settings tour

Only the shell's own parts make these sounds (Settings, dashboard, hot corner, welcome), never other apps.
The Quickshell parts play them themselves (QtMultimedia when it is there, else pw-play); this tool is
for scripts and for trying them.
"""
import json
import os
import shutil
import signal
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/sfx.json"
SND = HOME + "/.local/share/rice/sounds/sfx"
CACHE = HOME + "/.cache/rice"
MUSIC_PID = CACHE + "/sfx-music.pid"
PACKS = ["tap", "soft", "pluck", "keys", "crystal", "bubble", "retro"]
EVENTS = ["click", "switch", "slider", "typing", "music"]
DEFAULTS = {"enabled": True, "volume": 45, "pack": "tap",
            "click": True, "switch": True, "slider": True, "typing": True, "music": True}
# which setting each sound belongs to
KIND = {"click": "click", "select": "click", "done": "click", "switch-on": "switch", "switch-off": "switch",
        "slide": "slider", "type": "typing"}


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
        for k, d in DEFAULTS.items():
            if k in raw and type(raw[k]) is type(d):
                c[k] = raw[k]
    except Exception:
        pass
    c["volume"] = max(0, min(100, int(c["volume"])))
    if c["pack"] not in PACKS:
        c["pack"] = "tap"
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    json.dump(c, open(tmp, "w"), indent=2)
    os.replace(tmp, CFG)


def player(path, vol, role="Event"):
    v = max(0.0, min(1.0, vol / 100.0))
    if shutil.which("pw-play"):
        return ["pw-play", "--media-role", role, "--volume", "%.2f" % v, path]
    if shutil.which("paplay"):
        return ["paplay", "--volume", str(int(65536 * v)), path]
    if shutil.which("ffplay"):
        return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-volume", str(int(v * 100)), path]
    if shutil.which("aplay"):
        return ["aplay", "-q", path]
    return None


def play(event, c=None, force=False):
    c = c or load()
    if not force:
        if not c["enabled"]:
            return
        if not event.startswith("intro/") and not c.get(KIND.get(event, "click"), True):
            return
    path = "%s/%s.wav" % (SND, event) if event.startswith("intro/") else "%s/%s/%s.wav" % (SND, c["pack"], event)
    if not os.path.exists(path):
        return
    cmd = player(path, c["volume"])
    if cmd:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def music(on, c=None):
    c = c or load()
    try:
        pid = int(open(MUSIC_PID).read().strip())
        os.killpg(pid, signal.SIGTERM)
    except Exception:
        pass
    try:
        os.remove(MUSIC_PID)
    except OSError:
        pass
    if not on or not c["enabled"] or not c["music"]:
        return
    path = SND + "/music/calm.ogg"
    if not os.path.exists(path):
        return
    cmd = player(path, c["volume"] * 0.7, "Music")
    if not cmd:
        return
    os.makedirs(CACHE, exist_ok=True)
    p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    open(MUSIC_PID, "w").write(str(p.pid))


def main(a):
    cmd = a[1] if len(a) > 1 else "state"
    if cmd == "state":
        c = load()
        c["packs"] = [p for p in PACKS if os.path.isdir(SND + "/" + p)] or PACKS
        c["dir"] = SND
        print(json.dumps(c))
    elif cmd == "set":
        if len(a) < 4:
            sys.exit("usage: rice-sfx set KEY VALUE")
        k, v = a[2], a[3]
        c = load()
        if k == "volume":
            c[k] = max(0, min(100, int(float(v))))
        elif k == "pack":
            if v not in PACKS:
                sys.exit("packs: " + " ".join(PACKS))
            c[k] = v
        elif k in DEFAULTS:
            c[k] = v.lower() in ("1", "on", "true", "yes")
        else:
            sys.exit("unknown setting: " + k)
        save(c)
        if k == "music" and not c[k]:
            music(False, c)
    elif cmd == "play":
        if len(a) < 3:
            sys.exit("usage: rice-sfx play EVENT")
        play(a[2], force="--force" in a)
    elif cmd == "music":
        music(len(a) > 2 and a[2] == "start")
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
