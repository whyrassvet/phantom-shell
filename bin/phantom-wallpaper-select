#!/usr/bin/env python3
"""Select a random wallpaper without applying it."""

import argparse
import json
import random
import subprocess
import sys
from pathlib import Path

from PIL import Image, UnidentifiedImageError


EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff", ".gif"}


def minimum_monitor_size():
    result = subprocess.run(["hyprctl", "-j", "monitors"], check=True,
                            capture_output=True, text=True, timeout=10)
    monitors = json.loads(result.stdout)
    if not isinstance(monitors, list) or not monitors:
        raise ValueError("No monitors available for size filtering")
    dimensions = []
    for monitor in monitors:
        if not isinstance(monitor, dict):
            raise ValueError("Invalid monitor information")
        width, height = monitor.get("width"), monitor.get("height")
        if type(width) is not int or type(height) is not int or width <= 0 or height <= 0:
            raise ValueError("Invalid monitor dimensions")
        dimensions.append((width, height))
    return min(w for w, _ in dimensions), min(h for _, h in dimensions)


def select(directory, current=None, size=None, threshold=0.8):
    directory = Path(directory).expanduser().resolve(strict=True)
    if not directory.is_dir():
        raise ValueError(f"Not a wallpaper directory: {directory}")
    candidates = []
    for path in directory.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in EXTENSIONS:
            continue
        try:
            with Image.open(path) as image:
                width, height = image.size
            if size and (width < size[0] * threshold or height < size[1] * threshold):
                continue
            candidates.append(path.resolve())
        except (OSError, ValueError, UnidentifiedImageError):
            continue
    if not candidates:
        raise ValueError("No valid wallpapers found")
    if current:
        current = Path(current).expanduser().resolve()
        alternatives = [path for path in candidates if path != current]
        if alternatives:
            candidates = alternatives
    return random.choice(candidates)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory")
    parser.add_argument("--current")
    parser.add_argument("--no-filter", action="store_true")
    args = parser.parse_args()
    try:
        size = None if args.no_filter else minimum_monitor_size()
        print(select(args.directory, args.current, size))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"phantom-wallpaper-select: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
