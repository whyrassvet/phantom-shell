#!/usr/bin/env bash
# Start the private launcher in the background and open it via IPC.
set -euo pipefail

config="${PHANTOM_BAR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/caelestia-bar}"
store="${XDG_DATA_HOME:-$HOME/.local/share}/phantom-shell"
if [ -L "$store/plugin-current" ] || [ -e "$store/plugin-current" ]; then
  default_qml="$store/plugin-current/lib/qt6/qml"
else
  # Support the original, directly installed prefix.
  default_qml="$store/lib/qt6/qml"
fi
qml="${PHANTOM_QML_ROOT:-$default_qml}"

if [ ! -f "$config/launcher.qml" ]; then
  printf 'phantom-app-launcher: configuration not found: %s\n' "$config/launcher.qml" >&2
  exit 1
fi
for module in . Config Settings Components Services Models Images Blobs I18n; do
  if [ ! -f "$qml/Caelestia/$module/qmldir" ]; then
    printf 'phantom-app-launcher: private QML module not found: %s\n' "$qml/Caelestia/$module" >&2
    exit 1
  fi
done
for entry in '.:core' 'Config:config' 'Settings:settings' 'Components:components' 'Services:services' 'Models:models' 'Images:images' 'Blobs:blobs' 'I18n:i18n'; do
  module="${entry%%:*}"
  plugin="${entry#*:}"
  if [ ! -f "$qml/Caelestia/$module/libcaelestia-${plugin}plugin.so" ]; then
    printf 'phantom-app-launcher: private plugin not found: %s\n' "$qml/Caelestia/$module/libcaelestia-${plugin}plugin.so" >&2
    exit 1
  fi
done
for library in core config settings components services models images blobs i18n; do
  if [ ! -f "$qml/Caelestia/lib/libcaelestia-$library.so" ]; then
    printf 'phantom-app-launcher: private library not found: %s\n' "$qml/Caelestia/lib/libcaelestia-$library.so" >&2
    exit 1
  fi
done
if ! command -v qs >/dev/null 2>&1; then
  printf 'phantom-app-launcher: qs executable not found\n' >&2
  exit 1
fi

export QML_IMPORT_PATH="$qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export LD_LIBRARY_PATH="$qml/Caelestia/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/phantom-shell"
case "${1:---open}" in
  --run) exec qs -n -p "$config/launcher.qml" ;;
  --open|--start) mode="${1:---open}" ;;
  *) printf 'usage: phantom-app-launcher [--start|--open]\n' >&2; exit 2 ;;
esac

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  printf 'phantom-app-launcher: XDG_RUNTIME_DIR is not set\n' >&2
  exit 1
fi
exec 9>"$XDG_RUNTIME_DIR/phantom-app-launcher.lock"
flock -x 9
ipc() { qs -p "$config/launcher.qml" ipc call phantomLauncher "$1"; }
if ! ipc ping >/dev/null 2>&1; then
  qs -n -d -p "$config/launcher.qml" 9>&-
  ready=false
  for ((i=0; i<100; i++)); do
    if ipc ping >/dev/null 2>&1; then ready=true; break; fi
    sleep 0.1
  done
  if [ "$ready" != true ]; then
    printf 'phantom-app-launcher: background process did not become ready\n' >&2
    exit 1
  fi
fi
if [ "$mode" = --open ]; then
  ipc open >/dev/null
fi
